     "submitTime": 1788599681533,
     "tableResultSettingsMap": {},
     "title": ""
    }
   },
   "outputs": [],
   "source": [
    "from pyspark.sql.functions import current_timestamp,col\n",
    "bronze_df=(spark.readStream.format(\"cloudFiles\")\n",
    "        .option(\"cloudFiles.format\",\"parquet\")\n",
    "        .option(\"cloudFiles.schemaLocation\",schema_path)\n",
    "        .option(\"cloudFiles.schemaEvolutionMode\",\"rescue\")\n",
    "        .option(\"rescuedDataColumn\",\"bad_data\")\n",
    "        .load(source_path)\n",
    "        .withColumn(\"source_file\",col(\"_metadata.file_name\"))\n",
    "        .withColumn(\"path\",col(\"_metadata.file_path\"))\n",
    "        .withColumn(\"ingest_time\", current_timestamp())\n",
    "        )\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {
