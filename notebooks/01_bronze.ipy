   "source": [
    "source_path=\"/Volumes/workspace/nyc_taxi/volumes/incoming/yellow_taxi/\"\n",
    "checkpoint_path=\"/Volumes/workspace/nyc_taxi/volumes/checkpoints/bronze_v2/\"\n",
    "schema_path=\"/Volumes/workspace/nyc_taxi/volumes/schema/bronze_v2/\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
